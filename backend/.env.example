SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=paste-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
PORT=4000
# Production hardening (see docs/sec,ui,prod/)
FRONTEND_URL=http://localhost:3000
STORAGE_QUOTA_BYTES=1073741824
# Reverse proxy / rate limiting (see scripts/security-attack.mjs)
TRUST_PROXY=false
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=1048576
CONNECTION_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=30000
# Set ALLOW_BOOTSTRAP=1 only for first local setup; never in production.
# ALLOW_BOOTSTRAP=0
# NODE_ENV=development
